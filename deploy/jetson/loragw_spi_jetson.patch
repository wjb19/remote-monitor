 #define LGW_BURST_CHUNK     1024
 
+/*
+ * Jetson Nano header chip-select rises before the last byte of a hardware
+ * SPI transfer is latched. Bitbang mode 0 on PC0/PC1/PC2/PC3 keeps CS low
+ * for the whole frame. Do not map the SPI controller; it is clock-gated.
+ */
+static void bb_shutdown(void);
+static int bb_fd = -1;
+static volatile uint32_t *bb_gpio;
+static volatile uint32_t *bb_pin;
+
+static void bb_msk(unsigned reg, int bit, int on) {
+    uint32_t m = 1u << bit;
+    bb_gpio[reg / 4] = (m << 8) | (on ? m : 0);
+}
+
+static void bb_out(int bit, int high) {
+    bb_msk(0xA8, bit, high);
+}
+
+static int bb_miso(void) {
+    return (int)((bb_gpio[0x38 / 4] >> 1) & 1);
+}
+
+static void bb_delay(void) {
+    volatile int i;
+    for (i = 0; i < 40; ++i) {
+    }
+}
+
+static void bb_claim(void) {
+    int bit;
+    bb_pin[0x50 / 4] = 0xE041; /* MOSI */
+    bb_pin[0x54 / 4] = 0xE041; /* MISO */
+    bb_pin[0x58 / 4] = 0xE041; /* SCK */
+    bb_pin[0x5C / 4] = 0xE049; /* CS, pull-up */
+    for (bit = 0; bit < 4; ++bit) {
+        bb_msk(0x88, bit, 1);
+        bb_msk(0x98, bit, bit != 1);
+    }
+    bb_out(2, 0);
+    bb_out(3, 1);
+}
+
+static void bb_release_pins(void) {
+    int bit;
+    if (bb_gpio == NULL || bb_pin == NULL) {
+        return;
+    }
+    for (bit = 0; bit < 4; ++bit) {
+        bb_msk(0x88, bit, 0);
+    }
+    bb_pin[0x50 / 4] = 0xE000;
+    bb_pin[0x54 / 4] = 0xE040;
+    bb_pin[0x58 / 4] = 0xE000;
+    bb_pin[0x5C / 4] = 0xE008;
+    bb_gpio[0x008 / 4] &= ~0x1Fu;
+}
+
+static int bb_init(void) {
+    if (bb_fd >= 0) {
+        return 0;
+    }
+    bb_fd = open("/dev/mem", O_RDWR | O_SYNC);
+    if (bb_fd < 0) {
+        return -1;
+    }
+    bb_pin = mmap(NULL, 0x1000, PROT_READ | PROT_WRITE, MAP_SHARED, bb_fd, 0x70003000);
+    bb_gpio = mmap(NULL, 0x1000, PROT_READ | PROT_WRITE, MAP_SHARED, bb_fd, 0x6000D000);
+    if (bb_pin == MAP_FAILED || bb_gpio == MAP_FAILED) {
+        return -1;
+    }
+    bb_claim();
+    static int hooked;
+    if (!hooked) {
+        atexit(bb_shutdown);
+        hooked = 1;
+    }
+    return 0;
+}
+
+static void bb_shutdown(void) {
+    bb_release_pins();
+    if (bb_pin != NULL && bb_pin != MAP_FAILED) {
+        munmap((void *)bb_pin, 0x1000);
+    }
+    if (bb_gpio != NULL && bb_gpio != MAP_FAILED) {
+        munmap((void *)bb_gpio, 0x1000);
+    }
+    bb_pin = NULL;
+    bb_gpio = NULL;
+    if (bb_fd >= 0) {
+        close(bb_fd);
+        bb_fd = -1;
+    }
+}
+
+static void bb_xfer(const uint8_t *tx, uint8_t *rx, int len) {
+    int n, b;
+    bb_out(2, 0);
+    bb_out(3, 0);
+    for (n = 0; n < len; ++n) {
+        uint8_t acc = 0;
+        uint8_t byte = tx ? tx[n] : 0;
+        for (b = 7; b >= 0; --b) {
+            bb_out(0, (byte >> b) & 1);
+            bb_delay();
+            bb_out(2, 1);
+            acc = (uint8_t)((acc << 1) | (uint8_t)bb_miso());
+            bb_delay();
+            bb_out(2, 0);
+        }
+        if (rx) {
+            rx[n] = acc;
+        }
+    }
+    bb_delay();
+    bb_out(3, 1);
+}
+
