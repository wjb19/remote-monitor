[Unit]
Description=Remote Monitor Lab Jetson Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bill
Group=bill
WorkingDirectory=/opt/rmlab
Environment=RMLAB_PORT=8090
Environment=RMLAB_MAIN_URL=http://192.168.1.14:8080
Environment=RMLAB_MQTT_HOST=192.168.1.14
Environment=RMLAB_GATEWAY_SERVER=192.168.1.14
ExecStart=/usr/bin/python3 /opt/rmlab/services/jetson_agent/main.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
