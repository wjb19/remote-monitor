[Unit]
Description=Remote Monitor Lab Jetson Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bill
Group=bill
WorkingDirectory=/opt/rmlab
Environment=RMLAB_PORT=8090
# Leave MAIN/MQTT/GATEWAY unset (or set to "auto") so hub_discover follows DHCP.
Environment=RMLAB_HUB_HOSTNAME=bill-GB-BXBT-1900
Environment=RMLAB_HUB_PEER_PATH=/opt/rmlab/data/hub_peer.json
ExecStart=/usr/bin/python3 /opt/rmlab/services/jetson_agent/main.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
